#!/bin/bash
###############################################################################
# irace target-runner for CBMLKH.
#
# CBMLKH takes a single config file, not CLI flags. Every switch in
# parameters.txt is already a `key=value` config line, so irace's parameters are
# written through verbatim; this script adds only what irace supplies per run
# (instance, seed) and what is machine-specific (paths). All algorithm
# configuration lives in parameters.txt.
#
# $1 config id, $2 instance id, $3 seed, $4 instance, rest = parameters.
###############################################################################
error() {
    echo "`TZ=UTC date`: $0: error: $@"
    exit 1
}

# This parses the arguments given by irace. Do not touch it!
CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE=$4
shift 4 || error "Not enough parameters"
CONFIG_PARAMS=$*
# End of parsing

###############################################################################
# EDIT THIS BLOCK
###############################################################################
# Path to the CBMLKH binary (build it with `make prd`).
EXE=/home/pedro/cbm/src/CBMLKH/main_prd
# Written into the config, so it need not match LKHWrapper.hpp's hardcoded value.
LKH_EXE=/home/pedro/cbm/src/LKH3/LKH
###############################################################################

if [ ! -x "$(command -v ${EXE})" ]; then
    error "${EXE}: not found or not executable (pwd: $(pwd))"
fi

# CBMLKH only opens the instance after Config::validate(), so without this a bad
# path surfaces as a generic "Error opening file" a whole run later. A bare name
# here means trainInstancesDir is not being applied in scenario.txt.
# -f as well as -r: trainInstancesDir is listed wholesale when trainInstancesFile
# is unset, so a subdirectory sitting among the instances would otherwise pass a
# readability check and fail later as "Malformed instance header".
if [ ! -f "${INSTANCE}" ] || [ ! -r "${INSTANCE}" ]; then
    error "instance is not a readable file: '${INSTANCE}' (pwd: $(pwd)). Check trainInstancesDir in scenario.txt."
fi

RUN_ID=c${CONFIG_ID}-${INSTANCE_ID}-${SEED}
CONFIG_FILE=$(mktemp "${TMPDIR:-/tmp}/cbmlkh-${RUN_ID}-XXXXXX.cfg")
# Unique per run: CBMLKH empties it at startup, so a shared directory would have
# concurrent runs deleting each other's in-flight LKH files.
LKH_TMP_DIR="${TMPDIR:-/tmp}/LKH-${RUN_ID}-$$/"
STDOUT=${RUN_ID}.stdout
STDERR=${RUN_ID}.stderr

cleanup() { rm -rf "${CONFIG_FILE}" "${LKH_TMP_DIR}"; }
trap cleanup EXIT

{
    echo "instancePath=${INSTANCE}"
    echo "iRace=true"
    # Replay is only exact under a maxIterations bound, not maxTime.
    echo "seed=${SEED}"
    echo "lkhPath=${LKH_EXE}"
    echo "lkhTmpDir=${LKH_TMP_DIR}"
    # Every irace parameter, verbatim. Parameters disabled by a condition are
    # omitted by irace entirely, not passed as NA.
    for arg in ${CONFIG_PARAMS}; do echo "${arg}"; done
} > "${CONFIG_FILE}"

$EXE "${CONFIG_FILE}" 1> ${STDOUT} 2> ${STDERR}
STATUS=$?

if [ $STATUS -ne 0 ] || [ ! -s "${STDOUT}" ]; then
    # Keep the config: diagnosing a failure needs it.
    cp "${CONFIG_FILE}" "${RUN_ID}.cfg" 2>/dev/null
    error "${EXE} failed (status ${STATUS}); see ${RUN_ID}.cfg and ${STDERR}"
fi

# With iRace=true the binary prints the best cost and nothing else.
COST=$(cat ${STDOUT})
if ! [[ "$COST" =~ ^[0-9]+$ ]]; then
    cp "${CONFIG_FILE}" "${RUN_ID}.cfg" 2>/dev/null
    error "unexpected output '${COST}'; see ${RUN_ID}.cfg and ${STDERR}"
fi

echo "$COST"
rm -f "${STDOUT}" "${STDERR}"
exit 0
